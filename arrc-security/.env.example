# Optional HTTPS endpoint that accepts JSON and returns a 2xx status on success.
# Without this endpoint, enquiries open the visitor's email app for review.
VITE_INQUIRY_ENDPOINT=

# Optional recruitment endpoint. Accepts multipart/form-data with a resume file.
# Return { "success": true } only after accepting the application.
# Without it, applicants prepare an email and attach their resume in their email app.
VITE_CAREERS_ENDPOINT=

# Set to the final production origin before the production build.
# Used for canonical URLs and Open Graph metadata.
VITE_SITE_URL=

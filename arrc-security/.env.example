# Copy this file to .env.local and enter your Gmail app password in SMTP_PASS.
# Server-only secrets: never add the VITE_ prefix to SMTP settings.
# Recipient for contact, quote and both career forms.
SMTP_TO=info@arcsecuritysolutions.in
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
# Use a Google app password, not your regular Gmail password. Keep it in .env.local only.
SMTP_PASS=
# Use a sender address your SMTP provider has authorized.
SMTP_FROM=your-sender@gmail.com

# Production Node server. npm start serves dist/ and both form endpoints.
PORT=3000
HOST=0.0.0.0
# Enable only when behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Set to the final production origin before the production build.
# Used for canonical URLs and Open Graph metadata.
VITE_SITE_URL=

# Optional endpoint overrides. The included Node backend is used by default.
VITE_INQUIRY_ENDPOINT=/api/enquiry
VITE_CAREERS_ENDPOINT=/api/careers
